---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DualPaneViewer from '../../components/DualPaneViewer.astro';
import ArchitectureDiagram from '../../components/ArchitectureDiagram.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const researchEntries = await getCollection('research');
  return researchEntries.map((entry: CollectionEntry<'research'>) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'research'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const diagramId = entry.slug === 'abductive-neuro-symbolic-engine'
  ? 'neuro-symbolic-pipeline'
  : 'cardiorenal-thesis-architecture';

const diagramPath = path.resolve(`./src/assets/diagrams/${diagramId}.svg`);
let svgContent = '';
if (fs.existsSync(diagramPath)) {
  svgContent = fs.readFileSync(diagramPath, 'utf8');
}

const dateFormatted = new Intl.DateTimeFormat('en-US', { 
  year: 'numeric', 
  month: 'long' 
}).format(entry.data.date);

const metaDescription = entry.data.abstract.slice(0, 150);
---

<BaseLayout 
  title={`${entry.data.title} — Research`}
  description={metaDescription}
>
  <div class="site-container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/research" class="breadcrumb-link">&larr; Research Archive</a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">{entry.data.title}</span>
    </nav>

    <header class="paper-header">
      <div class="paper-meta">
        <span class="eyebrow">{entry.data.isProposal ? 'Thesis Proposal' : 'Research Brief'}</span>
        <span class="paper-date">{dateFormatted}</span>
      </div>

      <h1 class="paper-title">{entry.data.title}</h1>

      {entry.data.isProposal && (
        <div class="notice-box">
          <strong>Academic Proposal Notice:</strong> This document represents an active undergraduate bachelor's 
          thesis proposal at Daffodil International University. 
          Supervised by: {entry.data.supervisor}.
        </div>
      )}

      <div class="abstract-section">
        <h2 class="abstract-heading">Abstract</h2>
        <p class="prose abstract-content">{entry.data.abstract}</p>
      </div>

      <div class="paper-actions">
        <div class="paper-tags">
          {entry.data.tags.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
        {entry.data.githubUrl && (
          <a href={entry.data.githubUrl} target="_blank" rel="noopener noreferrer" class="button">
            View Source Repository &rarr;
          </a>
        )}
      </div>
    </header>

    <hr class="hairline" />

    <DualPaneViewer 
      proseTitle="Theoretical Methodology & Specifications"
      proofTitle="Formal Verification (SMT-LIB2 & Z3) & Architecture"
    >
      <div slot="prose">
        <Content />
      </div>

      <div slot="proof" class="proof-column">
        {svgContent && (
          <ArchitectureDiagram 
            title={entry.data.title + " Pipeline"}
            ariaLabel={`Architecture diagram of ${entry.data.title}`}
            svgContent={svgContent}
            caption="Formal pipeline illustrating the translation of medical propositions into SMT constraints."
          />
        )}

        <div class="proof-block">
          <div class="proof-block-header">
            <span>SMT-LIB2 Solver Specification</span>
            <span class="proof-block-tag">Z3 Core</span>
          </div>
          <pre class="astro-code"><code>{entry.slug === 'abductive-neuro-symbolic-engine' ? `; SMT-LIB2 Clause Verification
(set-logic QF_LRA)
(declare-fun egfr () Real)
(declare-fun serum_k () Real)
(declare-fun rx_spironolactone () Bool)

; Patient Biomarker Assertions
(assert (= egfr 24.5))
(assert (= serum_k 5.4))
(assert (= rx_spironolactone true))

; Guideline Safety Invariant (KDIGO / ACC)
(assert (=> rx_spironolactone (and (>= egfr 30.0) (<= serum_k 5.0))))

; Solvability Check
(check-sat)
; Result: unsat
(get-unsat-core)
; Conflicting Core: [egfr_bound, serum_k_bound, rx_spironolactone]` : `; SMT-LIB2 Multi-Guideline Encoding
(set-logic QF_LRA)
(declare-fun egfr () Real)
(declare-fun k_serum () Real)
(declare-fun rasi_indicated () Bool)
(declare-fun mra_indicated () Bool)

; Patient Comorbidity Parameter Set
(assert (< egfr 30.0))
(assert (> k_serum 5.2))
(assert (= rasi_indicated true))
(assert (= mra_indicated true))

; Dual Blockade Invariant Check
(assert (not (and rasi_indicated mra_indicated)))
(check-sat)
; Result: unsat (Conflict Formally Proven)`}</code></pre>
        </div>

        <div class="properties-summary">
          <div class="property-row">
            <span class="property-name">Verification Backend</span>
            <span class="property-val">Microsoft Z3 (SMT-LIB2)</span>
          </div>
          <div class="property-row">
            <span class="property-name">Logic Theory</span>
            <span class="property-val">Quantifier-Free Linear Real Arithmetic (QF_LRA)</span>
          </div>
          <div class="property-row">
            <span class="property-name">Decision Nature</span>
            <span class="property-val">Decidable, Deterministic Proof</span>
          </div>
        </div>
      </div>
    </DualPaneViewer>
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .breadcrumb-link {
    color: var(--color-text-secondary);
  }

  .breadcrumb-link:hover {
    color: var(--color-accent);
  }

  .breadcrumb-separator {
    color: var(--color-border);
  }

  .paper-header {
    margin-bottom: var(--space-8);
  }

  .paper-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .paper-date {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .paper-title {
    font-size: 2.75rem;
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: var(--space-6);
    color: var(--color-text-primary);
  }

  .notice-box {
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-subtle);
    padding: var(--space-4) var(--space-5);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: var(--space-6);
  }

  .abstract-section {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-subtle);
    padding: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .abstract-heading {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-top: 0;
    margin-bottom: var(--space-2);
  }

  .abstract-content {
    font-size: 1.125rem;
    color: var(--color-text-primary);
    max-width: 100%;
    margin-bottom: 0;
  }

  .paper-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .paper-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .proof-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .proof-block {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-subtle);
    overflow: hidden;
  }

  .proof-block-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg-base);
    border-bottom: 1px solid var(--color-border-subtle);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .proof-block-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-accent);
  }

  .proof-block pre {
    margin: 0;
    border: none;
    border-radius: 0;
  }

  .properties-summary {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-subtle);
    padding: var(--space-4) var(--space-5);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .property-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .property-name {
    color: var(--color-text-muted);
  }

  .property-val {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .paper-title {
      font-size: 2.15rem;
    }
    .property-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }
  }
</style>
