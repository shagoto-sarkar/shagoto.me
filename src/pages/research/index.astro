---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExecutionCard from '../../components/ExecutionCard.astro';
import { getCollection } from 'astro:content';

const researchEntries = (await getCollection('research')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout 
  title="Research — Formal Verification & Neuro-Symbolic AI"
  description="Academic research, formal logic models, and undergraduate thesis proposals on embedding deterministic SMT constraints into probabilistic AI systems."
>
  <div class="site-container">
    <header class="page-intro">
      <span class="eyebrow">Academic Work</span>
      <h1 class="page-heading">Research &amp; Formal Verification</h1>
      <p class="prose page-desc">
        Investigating methods to bridge probabilistic language models with deterministic automated theorem proving. 
        Focus areas include medical guideline formalization, SMT constraint solving via Microsoft Z3, and eliminative abductive reasoning.
      </p>
    </header>

    <hr class="hairline page-divider" />

    <div class="research-list">
      {researchEntries.map((item) => (
        <ExecutionCard
          href={`/research/${item.slug}`}
          title={item.data.title}
          subtitle={item.data.supervisor ? `Supervised by: ${item.data.supervisor}` : undefined}
          description={item.data.abstract}
          date={item.data.date}
          tags={item.data.tags}
          status={item.data.status}
          isProposal={item.data.isProposal}
          actionText="Read research paper brief &rarr;"
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-intro {
    padding-top: var(--space-4);
    max-width: 820px;
  }

  .page-heading {
    font-size: 2.75rem;
    font-weight: 600;
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .page-desc {
    font-size: 1.1875rem;
    color: var(--color-text-secondary);
  }

  .page-divider {
    margin: var(--space-10) 0;
  }

  .research-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }

  @media (max-width: 840px) {
    .research-list {
      grid-template-columns: 1fr;
    }
    .page-heading {
      font-size: 2.25rem;
    }
  }
</style>
