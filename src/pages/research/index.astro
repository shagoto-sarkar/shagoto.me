---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExecutionCard from '../../components/ExecutionCard.astro';
import { getCollection } from 'astro:content';

const allResearch = await getCollection('research');
const researchEntries = [...allResearch].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Research & formal methods"
  description="Academic research, formal verification models, and undergraduate thesis proposals on embedding deterministic SMT constraints into clinical reasoning systems."
>
  <div class="site-container">
    <header class="archive-header">
      <div class="header-main">
        <span class="eyebrow">ACADEMIC INVESTIGATION</span>
        <h1 class="archive-heading">Research &amp; formal methods</h1>
        <p class="archive-desc">
          Undergraduate research exploring the integration of probabilistic language models with deterministic automated theorem proving (Z3 SMT solver) for clinical polypharmacy verification.
        </p>
      </div>
      <div class="header-meta">
        <span class="record-count">{researchEntries.length} investigations</span>
      </div>
    </header>

    <div class="archive-rows-container">
      {researchEntries.map((item) => (
        <ExecutionCard
          href={`/research/${item.slug}`}
          title={item.data.title}
          subtitle={item.data.supervisor ? `Academic supervision: ${item.data.supervisor}` : undefined}
          description={item.data.abstract}
          date={item.data.date}
          tags={item.data.tags}
          status={item.data.status}
          isProposal={item.data.isProposal}
          category="Research"
          actionText="Read research brief"
          variant="row"
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .archive-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
    padding-top: clamp(24px, 4vw, 48px);
    margin-bottom: clamp(32px, 5vw, 56px);
    flex-wrap: wrap;
  }

  .header-main {
    max-width: 780px;
  }

  .archive-heading {
    font-size: clamp(2.4rem, 4.4vw, 3.6rem);
    font-weight: 600;
    line-height: 1.1;
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .archive-desc {
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.8vw, 1.15rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .header-meta {
    padding-bottom: var(--space-2);
  }

  .record-count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    background-color: var(--color-bg-subtle);
    padding: 3px 10px;
    border-radius: var(--radius-subtle);
    border: 1px solid var(--color-border);
  }

  .archive-rows-container {
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(48px, 6vw, 88px);
  }

  @media (max-width: 640px) {
    .archive-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
  }
</style>
