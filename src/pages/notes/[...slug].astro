---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchitectureDiagram from '../../components/ArchitectureDiagram.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const notesEntries = (await getCollection('notes')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return notesEntries.map((entry: CollectionEntry<'notes'>, index: number) => {
    const prevEntry = index < notesEntries.length - 1 ? notesEntries[index + 1] : null;
    const nextEntry = index > 0 ? notesEntries[index - 1] : null;
    return {
      params: { slug: entry.slug },
      props: { entry, prevEntry, nextEntry },
    };
  });
}

interface Props {
  entry: CollectionEntry<'notes'>;
  prevEntry?: CollectionEntry<'notes'> | null;
  nextEntry?: CollectionEntry<'notes'> | null;
}

const { entry, prevEntry, nextEntry } = Astro.props;
const { Content } = await entry.render();

let svgContent = '';
if (entry.slug === 'headless-ubuntu-tailscale') {
  const diagramPath = path.resolve('./src/assets/diagrams/headless-ubuntu-architecture.svg');
  if (fs.existsSync(diagramPath)) {
    svgContent = fs.readFileSync(diagramPath, 'utf8');
  }
}

const dateFormatted = new Intl.DateTimeFormat('en-US', { 
  year: 'numeric', 
  month: 'long', 
  day: 'numeric' 
}).format(entry.data.date);

const words = entry.body.trim().split(/\s+/).length;
const readTimeMinutes = Math.max(1, Math.round(words / 200));
const readTime = `${readTimeMinutes} min read`;

const metaDescription = `Field note by Shagoto Sarkar: ${entry.data.title}.`;
---

<BaseLayout 
  title={`${entry.data.title} — Notes`}
  description={metaDescription}
>
  <div class="site-container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/notes" class="breadcrumb-link">&larr; Notes &amp; Essays</a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">{entry.data.title}</span>
    </nav>

    <article class="note-article">
      <header class="note-header">
        <div class="note-meta">
          <span class="eyebrow">{entry.data.category}</span>
          <div class="meta-right">
            <time class="note-date">{dateFormatted}</time>
            <span class="meta-sep">&bull;</span>
            <span class="reading-time">{readTime}</span>
          </div>
        </div>

        <h1 class="note-title">{entry.data.title}</h1>

        <div class="note-tags">
          {entry.data.tags.map(t => (
            <span class="tag">{t}</span>
          ))}
        </div>
      </header>

      <hr class="hairline" />

      {svgContent && (
        <div class="note-diagram">
          <ArchitectureDiagram 
            title="Server & Mesh Network Topology"
            ariaLabel="Architecture diagram illustrating headless server deployment over Tailscale mesh network."
            svgContent={svgContent}
            caption="Zero-trust WireGuard mesh infrastructure routing secure SSH tunnels into the headless compute node."
          />
        </div>
      )}

      <div class="note-body prose">
        <Content />
      </div>

      <nav class="article-pagination" aria-label="Sequential Notes Navigation">
        <div class="pagination-prev">
          {prevEntry && (
            <a href={`/notes/${prevEntry.slug}`} class="pagination-link prev">
              <span class="pagination-direction">&larr; Older Note</span>
              <span class="pagination-title">{prevEntry.data.title}</span>
            </a>
          )}
        </div>
        <div class="pagination-index">
          <a href="/notes" class="pagination-link index">
            <span class="pagination-direction">Directory</span>
            <span class="pagination-title">All Notes</span>
          </a>
        </div>
        <div class="pagination-next">
          {nextEntry && (
            <a href={`/notes/${nextEntry.slug}`} class="pagination-link next">
              <span class="pagination-direction">Newer Note &rarr;</span>
              <span class="pagination-title">{nextEntry.data.title}</span>
            </a>
          )}
        </div>
      </nav>
    </article>
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .breadcrumb-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--motion-duration) ease;
  }

  .breadcrumb-link:hover {
    color: var(--color-accent);
  }

  .breadcrumb-separator {
    color: var(--color-border);
  }

  .breadcrumb-current {
    color: var(--color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 320px;
  }

  .note-header {
    max-width: var(--max-prose-width);
    margin-bottom: var(--space-8);
  }

  .note-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .note-date {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .meta-right {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .meta-sep {
    color: var(--color-border);
    font-size: 0.75rem;
  }

  .note-title {
    font-family: var(--font-editorial);
    font-size: clamp(2.1rem, 4vw, 2.75rem);
    font-weight: 600;
    line-height: 1.15;
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .note-diagram {
    max-width: var(--max-prose-width);
    margin: var(--space-8) 0;
  }

  .note-body {
    padding-top: var(--space-8);
    max-width: var(--max-prose-width);
  }

  @media (max-width: 640px) {
    .note-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
