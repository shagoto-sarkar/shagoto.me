---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExecutionCard from '../../components/ExecutionCard.astro';
import { getCollection } from 'astro:content';

const notesEntries = (await getCollection('notes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categories = [
  { id: 'all', label: 'All Notes' },
  { id: 'infrastructure', label: 'Infrastructure' },
  { id: 'academia', label: 'Academia' },
  { id: 'philosophy', label: 'Philosophy' }
];
---

<BaseLayout 
  title="Notes & Essays — Shagoto Sarkar"
  description="Personal notebook, systems documentation, assembly solutions, and intellectual reflections by Shagoto Sarkar."
>
  <div class="site-container">
    <header class="page-intro">
      <span class="eyebrow">Notebook &amp; Logs</span>
      <h1 class="page-heading">Notes, Field Logs &amp; Essays</h1>
      <p class="prose page-desc">
        An intellectual notebook covering headless server administration, low-level microprocessor optimizations, 
        and essays on moral complexity and technological determinism.
      </p>
      
      <div class="category-pills">
        {categories.map(cat => (
          <span class={`tag ${cat.id === 'all' ? 'accent' : ''}`}>
            {cat.label}
          </span>
        ))}
      </div>
    </header>

    <hr class="hairline page-divider" />

    <div class="notes-list">
      {notesEntries.map((item) => (
        <ExecutionCard
          href={`/notes/${item.slug}`}
          title={item.data.title}
          description={`Field notes and analysis covering ${item.data.tags.join(', ')}.`}
          date={item.data.date}
          tags={item.data.tags}
          category={item.data.category}
          actionText="Read entry &rarr;"
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-intro {
    padding-top: var(--space-4);
    max-width: 820px;
  }

  .page-heading {
    font-size: 2.75rem;
    font-weight: 600;
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .page-desc {
    font-size: 1.1875rem;
    color: var(--color-text-secondary);
  }

  .category-pills {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-6);
    flex-wrap: wrap;
  }

  .page-divider {
    margin: var(--space-10) 0;
  }

  .notes-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }

  @media (max-width: 840px) {
    .notes-list {
      grid-template-columns: 1fr;
    }
    .page-heading {
      font-size: 2.25rem;
    }
  }
</style>
