---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExecutionCard from '../../components/ExecutionCard.astro';
import { getCollection } from 'astro:content';

const notesEntries = (await getCollection('notes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categories = [
  { id: 'all', label: 'All Notes', count: notesEntries.length },
  { id: 'infrastructure', label: 'Infrastructure', count: notesEntries.filter(n => n.data.category?.toLowerCase() === 'infrastructure').length },
  { id: 'academia', label: 'Academia', count: notesEntries.filter(n => n.data.category?.toLowerCase() === 'academia').length },
  { id: 'philosophy', label: 'Philosophy', count: notesEntries.filter(n => n.data.category?.toLowerCase() === 'philosophy').length }
];
---

<BaseLayout 
  title="Notes & Essays — Shagoto Sarkar"
  description="Personal notebook, systems documentation, assembly solutions, and intellectual reflections by Shagoto Sarkar."
>
  <div class="site-container">
    <header class="page-intro">
      <span class="eyebrow">Notebook &amp; Logs</span>
      <h1 class="page-heading">Notes, Field Logs &amp; Essays</h1>
      <p class="prose page-desc">
        An intellectual notebook covering headless server administration, low-level microprocessor optimizations, 
        and essays on moral complexity and technological determinism.
      </p>
      
      <div class="category-pills" role="tablist" aria-label="Filter notes by category">
        {categories.map(cat => (
          <button 
            type="button" 
            class={`tag category-btn ${cat.id === 'all' ? 'accent active' : ''}`}
            data-category={cat.id}
            role="tab"
            aria-selected={cat.id === 'all' ? 'true' : 'false'}
          >
            {cat.label} <span class="cat-count">({cat.count})</span>
          </button>
        ))}
      </div>
    </header>

    <hr class="hairline page-divider" />

    <div class="notes-list" id="notes-grid">
      {notesEntries.map((item) => (
        <ExecutionCard
          href={`/notes/${item.slug}`}
          title={item.data.title}
          description={`Field notes and analysis covering ${item.data.tags.join(', ')}.`}
          date={item.data.date}
          tags={item.data.tags}
          category={item.data.category}
          actionText="Read entry &rarr;"
        />
      ))}
      <div id="notes-empty-state" class="notes-empty" style="display: none;">
        No notes found under this category.
      </div>
    </div>
  </div>

  <script is:inline>
    (function() {
      const buttons = document.querySelectorAll('.category-btn');
      const cards = document.querySelectorAll('#notes-grid .editorial-entry');
      const emptyState = document.getElementById('notes-empty-state');

      function applyFilter(category) {
        let visibleCount = 0;
        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category') || '';
          const match = category === 'all' || cardCat === category;
          if (match) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        buttons.forEach(btn => {
          const isCurrent = btn.getAttribute('data-category') === category;
          if (isCurrent) {
            btn.classList.add('accent', 'active');
            btn.setAttribute('aria-selected', 'true');
          } else {
            btn.classList.remove('accent', 'active');
            btn.setAttribute('aria-selected', 'false');
          }
        });

        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-category') || 'all';
          applyFilter(cat);
          const newHash = cat === 'all' ? '' : '#' + cat;
          if (window.location.hash !== newHash) {
            history.replaceState(null, '', newHash || window.location.pathname);
          }
        });
      });

      const hash = window.location.hash.replace('#', '').toLowerCase();
      if (hash && ['infrastructure', 'academia', 'philosophy'].includes(hash)) {
        applyFilter(hash);
      }
    })();
  </script>
</BaseLayout>

<style>
  .page-intro {
    padding-top: var(--space-4);
    max-width: 820px;
  }

  .page-heading {
    font-size: 2.75rem;
    font-weight: 600;
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .page-desc {
    font-size: 1.1875rem;
    color: var(--color-text-secondary);
  }

  .category-pills {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-6);
    flex-wrap: wrap;
  }

  .category-btn {
    cursor: pointer;
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    transition: all var(--motion-duration) ease;
    font-size: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .category-btn:hover {
    border-color: var(--color-text-secondary);
  }

  .category-btn.active {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background-color: var(--color-accent-subtle);
  }

  .cat-count {
    opacity: 0.75;
    font-size: 0.6875rem;
  }

  .page-divider {
    margin: var(--space-10) 0;
  }

  .notes-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }

  .notes-empty {
    padding: var(--space-8);
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    grid-column: 1 / -1;
  }

  @media (max-width: 840px) {
    .notes-list {
      grid-template-columns: 1fr;
    }
    .page-heading {
      font-size: 2.25rem;
    }
  }
</style>
