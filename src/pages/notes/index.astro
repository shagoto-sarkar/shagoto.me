---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExecutionCard from '../../components/ExecutionCard.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes');
const notesEntries = [...allNotes].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const NOTE_DESCRIPTIONS: Record<string, string> = {
  'headless-ubuntu-tailscale': 'Field notes on deploying and maintaining private headless Linux servers using WireGuard mesh topologies and automated systemd units.',
  '8086-microprocessor-assembly': 'Low-level 8086 assembly implementations, register allocation tradeoffs, interrupt handling, and accumulator arithmetic routines.',
  'moral-complexity-dostoevsky-arcane': 'A critical inquiry into systemic determinism, moral friction, and tragic necessity across classical Russian literature and contemporary narrative animation.'
};

const categories = [
  { id: 'all', label: 'All Notes', count: notesEntries.length },
  { id: 'infrastructure', label: 'Infrastructure', count: notesEntries.filter(n => n.data.category?.toLowerCase() === 'infrastructure').length },
  { id: 'academia', label: 'Academia', count: notesEntries.filter(n => n.data.category?.toLowerCase() === 'academia').length },
  { id: 'philosophy', label: 'Philosophy', count: notesEntries.filter(n => n.data.category?.toLowerCase() === 'philosophy').length }
];
---

<BaseLayout
  title="Notes & essays"
  description="Personal notebook, systems documentation, assembly solutions, and intellectual reflections by Shagoto Sarkar."
>
  <div class="site-container">
    <header class="archive-header">
      <div class="header-main">
        <span class="eyebrow">NOTEBOOK &amp; ESSAYS</span>
        <h1 class="archive-heading">Notes &amp; essays</h1>
        <p class="archive-desc">
          An intellectual notebook covering headless server administration, low-level microprocessor optimizations, and essays on moral complexity and technological determinism.
        </p>

        <!-- Accessible Filter Toggle Buttons -->
        <div class="category-filters" role="group" aria-label="Filter notes by topic">
          {categories.map((cat) => (
            <button
              type="button"
              class={`filter-btn ${cat.id === 'all' ? 'active' : ''}`}
              data-category={cat.id}
              aria-pressed={cat.id === 'all' ? 'true' : 'false'}
            >
              <span class="btn-label">{cat.label}</span>
              <span class="btn-count">({cat.count})</span>
            </button>
          ))}
        </div>
      </div>

      <div class="header-meta">
        <span class="record-count">{notesEntries.length} entries</span>
      </div>
    </header>

    <div class="archive-rows-container" id="notes-container">
      {notesEntries.map((item) => (
        <ExecutionCard
          href={`/notes/${item.slug}`}
          title={item.data.title}
          description={NOTE_DESCRIPTIONS[item.slug] || `Field notes and inquiries covering ${item.data.tags.join(', ')}.`}
          date={item.data.date}
          tags={item.data.tags}
          category={item.data.category}
          actionText="Read essay"
          variant="row"
        />
      ))}
      <div id="notes-empty-state" class="notes-empty" style="display: none;">
        No notes found in this category.
      </div>
    </div>
  </div>

  <script is:inline>
    (function() {
      const buttons = document.querySelectorAll('.filter-btn');
      const entries = document.querySelectorAll('#notes-container .editorial-entry');
      const emptyState = document.getElementById('notes-empty-state');

      function filterCategory(targetCat) {
        let count = 0;
        entries.forEach((entry) => {
          const entryCat = entry.getAttribute('data-category') || '';
          const matches = targetCat === 'all' || entryCat === targetCat;
          if (matches) {
            entry.style.display = 'grid';
            count++;
          } else {
            entry.style.display = 'none';
          }
        });

        buttons.forEach((btn) => {
          const isSelected = btn.getAttribute('data-category') === targetCat;
          btn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
          if (isSelected) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });

        if (emptyState) {
          emptyState.style.display = count === 0 ? 'block' : 'none';
        }
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-category') || 'all';
          filterCategory(cat);
          const hash = cat === 'all' ? '' : '#' + cat;
          if (window.location.hash !== hash) {
            history.replaceState(null, '', hash || window.location.pathname);
          }
        });
      });

      const initialHash = window.location.hash.replace('#', '').toLowerCase();
      if (initialHash && ['infrastructure', 'academia', 'philosophy'].includes(initialHash)) {
        filterCategory(initialHash);
      }
    })();
  </script>
</BaseLayout>

<style>
  .archive-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
    padding-top: clamp(24px, 4vw, 48px);
    margin-bottom: clamp(32px, 5vw, 56px);
    flex-wrap: wrap;
  }

  .header-main {
    max-width: 780px;
  }

  .archive-heading {
    font-size: clamp(2.4rem, 4.4vw, 3.6rem);
    font-weight: 600;
    line-height: 1.1;
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .archive-desc {
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.8vw, 1.15rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }

  .category-filters {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-subtle);
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all var(--motion-duration) ease;
  }

  .filter-btn:hover {
    border-color: var(--color-text-secondary);
    color: var(--color-text-primary);
  }

  .filter-btn.active {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background-color: var(--color-accent-subtle);
  }

  .btn-count {
    opacity: 0.75;
    font-size: 0.68rem;
  }

  .header-meta {
    padding-bottom: var(--space-2);
  }

  .record-count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    background-color: var(--color-bg-subtle);
    padding: 3px 10px;
    border-radius: var(--radius-subtle);
    border: 1px solid var(--color-border);
  }

  .archive-rows-container {
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(48px, 6vw, 88px);
  }

  .notes-empty {
    padding: var(--space-12) 0;
    text-align: center;
    font-family: var(--font-sans);
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    .archive-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
  }
</style>
