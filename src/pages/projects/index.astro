---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExecutionCard from '../../components/ExecutionCard.astro';
import { getCollection } from 'astro:content';

// Curated order as prescribed by Section 7 of Quiet Precision specification
const RANKING = [
  'serialnow-queue-system',
  'cashapp-expense-governor',
  'opengl-lower-manhattan',
  'go-edge-router',
  'log-cognitive-journal',
  'js-mini-compiler-ide',
  'java-ridesharing-gui'
];

const allProjects = await getCollection('projects');
const projectEntries = [...allProjects].sort((a, b) => {
  const rankA = RANKING.indexOf(a.slug);
  const rankB = RANKING.indexOf(b.slug);
  if (rankA !== -1 && rankB !== -1) return rankA - rankB;
  if (rankA !== -1) return -1;
  if (rankB !== -1) return 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
---

<BaseLayout
  title="Projects & systems"
  description="Software projects, experiments, and engineering case studies—from practical web applications to graphics and language tooling."
>
  <div class="site-container">
    <header class="archive-header">
      <div class="header-main">
        <span class="eyebrow">ENGINEERING ARCHIVE</span>
        <h1 class="archive-heading">Projects &amp; systems</h1>
        <p class="archive-desc">
          Software projects, experiments, and engineering case studies—from practical web applications to graphics and language tooling.
        </p>
      </div>
      <div class="header-meta">
        <span class="record-count">{projectEntries.length} systems documented</span>
      </div>
    </header>

    <div class="archive-rows-container">
      {projectEntries.map((item) => (
        <ExecutionCard
          href={`/projects/${item.slug}`}
          title={item.data.title}
          subtitle={item.data.collaborators?.length ? `In collaboration with ${item.data.collaborators.join(', ')}` : undefined}
          description={item.data.constraint}
          date={item.data.date}
          tags={item.data.techStack}
          category="Engineering"
          actionText="Read case study"
          variant="row"
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .archive-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
    padding-top: clamp(24px, 4vw, 48px);
    margin-bottom: clamp(32px, 5vw, 56px);
    flex-wrap: wrap;
  }

  .header-main {
    max-width: 780px;
  }

  .archive-heading {
    font-size: clamp(2.4rem, 4.4vw, 3.6rem);
    font-weight: 600;
    line-height: 1.1;
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .archive-desc {
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.8vw, 1.15rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .header-meta {
    padding-bottom: var(--space-2);
  }

  .record-count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    background-color: var(--color-bg-subtle);
    padding: 3px 10px;
    border-radius: var(--radius-subtle);
    border: 1px solid var(--color-border);
  }

  .archive-rows-container {
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(48px, 6vw, 88px);
  }

  @media (max-width: 640px) {
    .archive-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
  }
</style>
