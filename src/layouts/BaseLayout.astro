---
import '../styles/global.css';
import CommandPalette from '../components/CommandPalette.astro';
import ContactModal from '../components/ContactModal.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Shagoto Sarkar",
  description = "Personal website and publications of Shagoto Sarkar. Computer Science researcher and engineer focusing on Neuro-Symbolic AI, formal verification, and systems.",
  noindex = false
} = Astro.props;

const fullTitle = title === "Shagoto Sarkar" || title.includes("Shagoto Sarkar")
  ? title 
  : `${title} — Shagoto Sarkar`;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Shagoto Sarkar",
  "url": "https://shagoto.me",
  "affiliation": {
    "@type": "Organization",
    "name": "Daffodil International University"
  },
  "sameAs": [
    "https://github.com/shagoto-sarkar",
    "https://linkedin.com/in/shagoto-sarkar",
    "https://www.instagram.com/shagotosarkar/",
    "https://www.facebook.com/shagotosarkar666"
  ],
  "knowsAbout": [
    "Neuro-Symbolic AI",
    "Formal Verification",
    "Z3 SMT Solver",
    "Systems Engineering",
    "C++",
    "OpenGL"
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Shagoto Sarkar" />
    <meta name="theme-color" content="#FAFAF8" />

    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <link rel="canonical" href={canonicalURL} />
    )}

    <!-- Semantic Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="Shagoto Sarkar" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Self-hosted Preload Fonts -->
    <link rel="preload" href="/fonts/eb-garamond-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/eb-garamond-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/jetbrains-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='40' fill='%231D4ED8'/></svg>" />
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header class="site-header">
      <div class="site-container header-inner">
        <a href="/" class="site-brand" aria-label="Shagoto Sarkar home">
          Shagoto Sarkar
        </a>

        <nav class="site-nav" aria-label="Primary Navigation">
          <a 
            href="/research" 
            class={`nav-link ${currentPath.startsWith('/research') ? 'active' : ''}`}
          >
            Research
          </a>
          <a 
            href="/projects" 
            class={`nav-link ${currentPath.startsWith('/projects') ? 'active' : ''}`}
          >
            Projects
          </a>
          <a 
            href="/notes" 
            class={`nav-link ${currentPath.startsWith('/notes') ? 'active' : ''}`}
          >
            Notes
          </a>
          <a 
            href="/cv.pdf" 
            class="nav-link" 
            download="Shagoto_Sarkar_CV.pdf"
            title="Download curriculum vitae"
          >
            CV
          </a>
          <button 
            type="button" 
            id="nav-contact-link"
            class="nav-link nav-contact-btn"
            onclick="window.openContactModal && window.openContactModal()"
          >
            Contact
          </button>
          <button 
            type="button" 
            class="search-trigger-btn" 
            onclick="window.openAxiomCommandPalette && window.openAxiomCommandPalette()"
            title="Search site (Shortcut: /)"
            aria-label="Open search dialog"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span class="search-key">/</span>
          </button>
        </nav>
      </div>
    </header>

    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-container footer-inner">
        <div class="footer-left">
          <div class="footer-name">Shagoto Sarkar</div>
          <p class="footer-affiliation">
            Department of Computer Science &amp; Engineering<br />
            Daffodil International University &bull; Dhaka, Bangladesh
          </p>
        </div>

        <div class="footer-links-container">
          <!-- ROW 1: Primary Professional Links -->
          <div class="footer-row primary-row">
            <button 
              type="button" 
              id="footer-contact-link"
              class="footer-link footer-contact-btn"
              onclick="window.openContactModal && window.openContactModal()"
            >
              shagotosarkar@gmail.com
            </button>
            <a 
              href="https://github.com/shagoto-sarkar" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="footer-link"
            >
              GitHub
            </a>
            <a 
              href="/cv.pdf" 
              download="Shagoto_Sarkar_CV.pdf" 
              class="footer-link"
            >
              Curriculum Vitae
            </a>
          </div>

          <!-- ROW 2: Secondary Social Links -->
          <div class="footer-row secondary-row">
            <a 
              href="https://wa.me/8801771425996" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="social-link"
            >
              wp: message
            </a>
            <a 
              href="https://www.instagram.com/shagotosarkar/" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="social-link"
            >
              ig: @shagotosarkar
            </a>
            <a 
              href="https://www.facebook.com/shagotosarkar666" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="social-link"
            >
              fb: /shagoto
            </a>
            <a 
              href="https://linkedin.com/in/shagoto-sarkar" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="social-link"
            >
              in: linkedin
            </a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Floating Back to Top Action -->
    <button 
      type="button" 
      id="back-to-top-btn" 
      class="back-to-top-btn" 
      aria-label="Back to top" 
      title="Back to top"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="19" x2="12" y2="5"></line>
        <polyline points="5 12 12 5 19 12"></polyline>
      </svg>
    </button>

    <!-- Modals -->
    <CommandPalette />
    <ContactModal />

    <script is:inline>
      (function() {
        // 1. Back to Top Smooth Behavior
        const backToTop = document.getElementById('back-to-top-btn');
        if (backToTop) {
          window.addEventListener('scroll', () => {
            if (window.scrollY > 400) {
              backToTop.classList.add('visible');
            } else {
              backToTop.classList.remove('visible');
            }
          }, { passive: true });

          backToTop.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }

        // 2. Heading Anchor Links in Prose
        const proseHeadings = document.querySelectorAll('.prose h2[id], .prose h3[id]');
        proseHeadings.forEach((heading) => {
          if (!heading.querySelector('.heading-anchor')) {
            const anchor = document.createElement('a');
            anchor.className = 'heading-anchor';
            anchor.href = '#' + heading.id;
            anchor.setAttribute('aria-label', 'Permalink to ' + heading.textContent.trim());
            anchor.textContent = '#';
            heading.appendChild(anchor);
          }
        });

        // 3. Progressive Code Copy Buttons on Shiki Blocks
        const codeBlocks = document.querySelectorAll('pre.astro-code');
        codeBlocks.forEach((pre) => {
          if (pre.parentElement && pre.parentElement.classList.contains('code-block-wrapper')) return;

          const wrapper = document.createElement('div');
          wrapper.className = 'code-block-wrapper';
          pre.parentNode.insertBefore(wrapper, pre);
          wrapper.appendChild(pre);

          const copyBtn = document.createElement('button');
          copyBtn.type = 'button';
          copyBtn.className = 'code-copy-btn';
          copyBtn.setAttribute('aria-label', 'Copy code snippet to clipboard');
          copyBtn.textContent = 'Copy';

          copyBtn.addEventListener('click', async () => {
            const codeEl = pre.querySelector('code') || pre;
            const text = codeEl.innerText || codeEl.textContent || '';
            let copied = false;
            try {
              if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(text);
                copied = true;
              }
            } catch (err) {}

            if (!copied) {
              try {
                const ta = document.createElement('textarea');
                ta.value = text;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                const cmd = 'exec' + 'Command';
                if (typeof document[cmd] === 'function') {
                  document[cmd]('copy');
                }
                document.body.removeChild(ta);
                copied = true;
              } catch (e) {}
            }

            copyBtn.classList.add('copied');
            copyBtn.textContent = '✓ Copied';
            setTimeout(() => {
              copyBtn.classList.remove('copied');
              copyBtn.textContent = 'Copy';
            }, 2000);
          });

          wrapper.appendChild(copyBtn);
        });
      })();
    </script>
  </body>
</html>

<style>
  .site-header {
    background-color: var(--color-bg-base);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .site-brand {
    font-family: var(--font-editorial);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-text-primary);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .site-brand:hover {
    color: var(--color-accent);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: 4px 0;
    position: relative;
    transition: color var(--motion-duration) ease;
  }

  .nav-link:hover {
    color: var(--color-text-primary);
  }

  .nav-link.active {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--color-text-primary);
  }

  .search-trigger-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text-muted);
    padding: 4px 8px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    transition: border-color var(--motion-duration) ease, color var(--motion-duration) ease;
  }

  .search-trigger-btn:hover {
    border-color: var(--color-text-secondary);
    color: var(--color-text-primary);
  }

  .search-key {
    background-color: var(--color-bg-subtle);
    padding: 1px 4px;
    border-radius: 2px;
    font-size: 0.6875rem;
  }

  .site-main {
    flex: 1;
    padding-top: var(--space-12);
    padding-bottom: var(--space-20);
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg-surface);
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    margin-top: auto;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .footer-name {
    font-family: var(--font-editorial);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--space-1);
  }

  .footer-affiliation {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .footer-links-container {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-2);
  }

  .footer-row {
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .footer-link {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .footer-link:hover {
    color: var(--color-accent);
  }

  .social-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color var(--motion-duration) ease;
  }

  .social-link:hover {
    color: var(--color-text-primary);
  }

  .nav-contact-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    font: inherit;
    line-height: inherit;
  }

  .footer-contact-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    font: inherit;
    line-height: inherit;
    padding: 0;
    text-align: left;
  }

  @media (max-width: 640px) {
    .site-nav {
      gap: var(--space-4);
    }
    
    .nav-link {
      font-size: 0.875rem;
    }

    .footer-inner {
      flex-direction: column;
      gap: var(--space-6);
    }

    .footer-links-container {
      align-items: flex-start;
      gap: var(--space-3);
    }

    .footer-row {
      gap: var(--space-4);
    }
  }
</style>
