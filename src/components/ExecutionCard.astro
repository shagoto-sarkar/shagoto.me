---
interface Props {
  href: string;
  title: string;
  subtitle?: string;
  description: string;
  date?: Date | string;
  tags?: string[];
  status?: string;
  isProposal?: boolean;
  category?: string;
  actionText?: string;
}

const {
  href,
  title,
  subtitle,
  description,
  date,
  tags = [],
  status,
  isProposal,
  category,
  actionText = "Read more →"
} = Astro.props;

const dateFormatted = date 
  ? (typeof date === 'string' 
      ? date 
      : new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short' }).format(date))
  : undefined;
---

<article class="editorial-entry" data-category={category ? category.toLowerCase() : ''}>
  <div class="entry-meta">
    {category && <span class="entry-category">{category}</span>}
    {status && (
      <span class="entry-status">
        {isProposal ? 'Thesis Proposal' : status}
      </span>
    )}
    {dateFormatted && <span class="entry-date">{dateFormatted}</span>}
  </div>

  <h3 class="entry-title">
    <a href={href}>{title}</a>
  </h3>

  {subtitle && <p class="entry-subtitle">{subtitle}</p>}

  <p class="entry-desc">{description}</p>

  {tags.length > 0 && (
    <div class="entry-tags">
      {tags.map((tag) => (
        <span class="entry-tag">{tag}</span>
      ))}
    </div>
  )}

  <div class="entry-action">
    <a href={href} class="entry-link" tabindex="-1" aria-hidden="true">{actionText}</a>
  </div>
</article>

<style>
  .editorial-entry {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-subtle);
    transition: border-color var(--motion-duration) ease, box-shadow var(--motion-duration) ease;
  }

  .editorial-entry:hover {
    border-color: var(--color-text-secondary);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  }

  .editorial-entry:hover .entry-title a,
  .editorial-entry:hover .entry-link {
    color: var(--color-accent);
  }

  .entry-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .entry-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .entry-category {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
  }

  .entry-status {
    color: var(--color-accent);
  }

  .entry-date {
    margin-left: auto;
  }

  .entry-title {
    font-family: var(--font-editorial);
    font-size: 1.45rem;
    font-weight: 600;
    line-height: 1.25;
    margin-bottom: var(--space-2);
    color: var(--color-text-primary);
  }

  .entry-title a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .entry-title a:hover {
    color: var(--color-accent);
  }

  .entry-subtitle {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .entry-desc {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    flex-grow: 1;
  }

  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .entry-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background-color: var(--color-bg-subtle);
    padding: 1px 6px;
    border-radius: var(--radius-subtle);
  }

  .entry-action {
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .entry-link {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .entry-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
